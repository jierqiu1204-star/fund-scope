{
  "schema_version": "etf_ranking_contract_v1",
  "contract_id": "final_score_v3",
  "selector": {
    "target_score_version": "final_score_v3",
    "score_field": "ranking_score",
    "activation_state": "publication_gated",
    "required_scope": "full",
    "fallback_when_unavailable": "none",
    "legacy_versions": ["final_score_v2"]
  },
  "calculation": {
    "method": "single_pass_weighted_sum",
    "apply_hard_limits": "after_aggregation",
    "renormalize_missing_weights": false,
    "missing_score_bearing_input": "score_unavailable",
    "price_basis": "total_return_adjusted",
    "components": [
      {
        "id": "technical_momentum_cross_section",
        "weight": 0.3,
        "score_bearing": true,
        "formula": {
          "type": "weighted_sum",
          "inputs": [
            {"primitive": "return_5d", "weight": 0.2, "direction": "higher_is_better", "normalization": "bucket_percentile"},
            {"primitive": "return_10d", "weight": 0.25, "direction": "higher_is_better", "normalization": "bucket_percentile"},
            {"primitive": "return_20d", "weight": 0.3, "direction": "higher_is_better", "normalization": "bucket_percentile"},
            {"primitive": "distance_to_ma20", "weight": 0.15, "direction": "higher_is_better", "normalization": "winsorized_bucket_percentile"},
            {"primitive": "trend_consistency", "weight": 0.1, "direction": "higher_is_better", "normalization": "bucket_percentile"}
          ]
        },
        "required_inputs": [
          "return_5d",
          "return_10d",
          "return_20d",
          "distance_to_ma20",
          "trend_consistency",
          "eligible_peer_count",
          "source_trade_date"
        ],
        "primitive_lineage": [
          "return_5d",
          "return_10d",
          "return_20d",
          "distance_to_ma20",
          "trend_consistency"
        ]
      },
      {
        "id": "risk_quality_cross_section",
        "weight": 0.2,
        "score_bearing": true,
        "formula": {
          "type": "weighted_sum",
          "inputs": [
            {"primitive": "realized_volatility_20d", "weight": 0.25, "direction": "lower_is_better", "normalization": "bucket_percentile"},
            {"primitive": "downside_volatility_20d", "weight": 0.25, "direction": "lower_is_better", "normalization": "bucket_percentile"},
            {"primitive": "max_drawdown_20d", "weight": 0.3, "direction": "lower_absolute_loss_is_better", "normalization": "bucket_percentile"},
            {
              "primitive": "overextension_atr",
              "weight": 0.2,
              "direction": "lower_is_better",
              "normalization": "winsorized_bucket_percentile",
              "definition": {
                "formula": "abs(adjusted_close - adjusted_ma20) / adjusted_atr20",
                "adjusted_ma20": "arithmetic_mean_last_20_adjusted_closes",
                "adjusted_atr20": "arithmetic_mean_last_20_adjusted_true_ranges",
                "adjusted_true_range": "max(adjusted_high - adjusted_low, abs(adjusted_high - previous_adjusted_close), abs(adjusted_low - previous_adjusted_close))",
                "required_adjusted_ohlc_points": 21,
                "penalized_directions": ["above_ma20", "below_ma20"],
                "missing_data_behavior": "score_unavailable"
              }
            }
          ]
        },
        "required_inputs": [
          "realized_volatility_20d",
          "downside_volatility_20d",
          "max_drawdown_20d",
          "overextension_atr",
          "eligible_peer_count",
          "source_trade_date"
        ],
        "primitive_lineage": [
          "realized_volatility_20d",
          "downside_volatility_20d",
          "max_drawdown_20d",
          "overextension_atr"
        ]
      },
      {
        "id": "structure_liquidity",
        "weight": 0.15,
        "score_bearing": true,
        "formula": {
          "type": "weighted_sum",
          "inputs": [
            {"primitive": "average_turnover_20d", "weight": 0.35, "direction": "higher_is_better", "normalization": "bucket_percentile"},
            {"primitive": "average_turnover_60d", "weight": 0.25, "direction": "higher_is_better", "normalization": "bucket_percentile"},
            {"primitive": "spread_bps", "weight": 0.2, "direction": "lower_is_better", "normalization": "bucket_percentile"},
            {"primitive": "structure_quality", "weight": 0.2, "direction": "higher_is_better", "normalization": "bounded_0_100"}
          ]
        },
        "required_inputs": [
          "average_turnover_20d",
          "average_turnover_60d",
          "spread_bps",
          "structure_quality",
          "source_trade_date"
        ],
        "primitive_lineage": [
          "average_turnover_20d",
          "average_turnover_60d",
          "spread_bps",
          "structure_quality"
        ]
      },
      {
        "id": "sector_trend",
        "weight": 0.15,
        "score_bearing": true,
        "formula": {
          "type": "weighted_sum",
          "inputs": [
            {"primitive": "sector_breadth_20d", "weight": 0.4, "direction": "higher_is_better", "normalization": "bounded_0_100"},
            {"primitive": "sector_momentum_20d", "weight": 0.35, "direction": "higher_is_better", "normalization": "bucket_percentile"},
            {"primitive": "sector_turnover_ratio_20_60", "weight": 0.25, "direction": "higher_is_better", "normalization": "winsorized_bucket_percentile"}
          ]
        },
        "required_inputs": [
          "sector_breadth_20d",
          "sector_momentum_20d",
          "sector_turnover_ratio_20_60",
          "sector_eligible_peer_count",
          "source_trade_date"
        ],
        "primitive_lineage": [
          "sector_breadth_20d",
          "sector_momentum_20d",
          "sector_turnover_ratio_20_60"
        ]
      },
      {
        "id": "theme_catalyst",
        "weight": 0.1,
        "score_bearing": true,
        "formula": {
          "type": "weighted_sum",
          "inputs": [
            {"primitive": "catalyst_quality", "weight": 0.6, "direction": "higher_is_better", "normalization": "bounded_0_100"},
            {"primitive": "catalyst_confidence", "weight": 0.4, "direction": "higher_is_better", "normalization": "bounded_0_100"}
          ]
        },
        "required_inputs": [
          "catalyst_quality",
          "catalyst_confidence",
          "catalyst_effective_at",
          "catalyst_expires_at",
          "catalyst_source"
        ],
        "primitive_lineage": [
          "catalyst_quality",
          "catalyst_confidence"
        ]
      },
      {
        "id": "premium_discount",
        "weight": 0.1,
        "score_bearing": true,
        "formula": {
          "type": "weighted_sum",
          "inputs": [
            {"primitive": "premium_discount_bps", "weight": 0.7, "direction": "closer_to_zero_is_better", "normalization": "absolute_distance_bucket_percentile"},
            {"primitive": "premium_provider_consensus", "weight": 0.3, "direction": "higher_is_better", "normalization": "bounded_0_100"}
          ]
        },
        "required_inputs": [
          "premium_discount_bps",
          "iopv_observed_at",
          "premium_provider_consensus"
        ],
        "primitive_lineage": [
          "premium_discount_bps",
          "premium_provider_consensus"
        ]
      }
    ],
    "dag": {
      "primitive_edges": "Each calculation.components[].formula.inputs[] entry is a directed primitive-to-component edge with frozen weight, direction, and normalization.",
      "component_edges": [
        {"from": "technical_momentum_cross_section", "to": "weighted_aggregate", "weight": 0.3},
        {"from": "risk_quality_cross_section", "to": "weighted_aggregate", "weight": 0.2},
        {"from": "structure_liquidity", "to": "weighted_aggregate", "weight": 0.15},
        {"from": "sector_trend", "to": "weighted_aggregate", "weight": 0.15},
        {"from": "theme_catalyst", "to": "weighted_aggregate", "weight": 0.1},
        {"from": "premium_discount", "to": "weighted_aggregate", "weight": 0.1}
      ],
      "terminal_edges": [
        {"from": "weighted_aggregate", "to": "reliability_gate"},
        {"from": "reliability_gate", "to": "risk_and_freshness_caps"},
        {"from": "risk_and_freshness_caps", "to": "ranking_score"}
      ],
      "acyclic_order": [
        "primitive_inputs",
        "technical_momentum_cross_section",
        "risk_quality_cross_section",
        "structure_liquidity",
        "sector_trend",
        "theme_catalyst",
        "premium_discount",
        "weighted_aggregate",
        "reliability_gate",
        "risk_and_freshness_caps",
        "ranking_score"
      ]
    }
  },
  "freshness": {
    "daily_market_structure_and_sector": {
      "rule": "source_trade_date_equals_snapshot_trade_date",
      "calendar": "china_exchange_calendar"
    },
    "theme_catalyst": {
      "maximum_age_hours": 72,
      "effective_window_required": true,
      "rule": "effective_at_lte_cutoff_and_cutoff_lt_expires_at"
    },
    "premium_discount": {
      "maximum_age_minutes": 15,
      "rule": "iopv_observed_at_within_cutoff_window"
    },
    "expired_input_action": "score_unavailable"
  },
  "reliability": {
    "severity_order": ["verified", "alternate_provider", "estimated", "stale", "unavailable"],
    "decision_eligible_statuses": ["verified", "alternate_provider"],
    "component_status": "worst_required_input_status",
    "aggregate_status": "worst_score_bearing_component_status",
    "execution_stage": "after_weighted_aggregate_before_risk_and_freshness_caps",
    "post_aggregation_actions": {
      "verified": {"score_eligible": true, "cap": null},
      "alternate_provider": {"score_eligible": true, "cap": null},
      "estimated": {"score_eligible": false, "cap": 45, "display_only": true},
      "stale": {"score_eligible": false, "cap": 55, "display_only": true},
      "unavailable": {"score_eligible": false, "cap": 45, "display_only": true}
    }
  },
  "eligibility": {
    "finite_score_inputs_required": true,
    "decision_eligible_sources_required": true,
    "same_trade_date_required": true,
    "display_only_input_is_missing": true,
    "neutral_or_zero_fill_allowed": false,
    "component_profiles_must_match": true
  },
  "hard_limits": {
    "stale_score_cap": 55,
    "unavailable_score_cap": 45,
    "risk_monotonicity": "adding_risk_cannot_increase_score",
    "quality_gate_precedence": "cannot_be_undone_by_later_enrichment"
  },
  "asset_buckets": {
    "comparable_bucket_ids": [
      "broad-equity",
      "sector/theme-equity",
      "fixed-income",
      "commodity",
      "cross-border"
    ],
    "unknown_or_incompatible": "score_unavailable",
    "cross_bucket_percentiles": false,
    "clone_policy": "one_underlying_distribution_contribution"
  },
  "anti_double_count": {
    "primitive_may_have_multiple_weighted_paths": false,
    "composite_and_children_may_both_be_weighted": false,
    "lineage_validation": "primitive_ids_unique_across_score_bearing_components"
  },
  "compatibility_aliases": {
    "output_fields": {
      "total_score": "ranking_score",
      "rank": "global_rank",
      "live_rank": "global_live_rank"
    },
    "sort_modes": {
      "opportunity": "ranking_score"
    },
    "not_aliases": ["opportunity_score", "final_score_v2"]
  },
  "ordering": {
    "missing_or_non_finite": "last",
    "zero_is_valid": true,
    "tie_break": [
      "score_eligible_desc",
      "ranking_score_desc",
      "persisted_global_rank_asc",
      "asset_code_asc"
    ]
  },
  "explanatory_only": [
    "label_validation",
    "historical_performance",
    "strategy_healthcheck",
    "ai_prose",
    "user_positions",
    "alerts",
    "notifications"
  ]
}
