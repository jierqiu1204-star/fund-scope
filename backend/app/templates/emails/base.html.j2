<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{{ title }}</title>
    <style>
      body { background: #f7f3e9; color: #112031; font-family: Arial, sans-serif; margin: 0; padding: 32px; }
      .card { background: #ffffff; border-radius: 24px; padding: 32px; max-width: 720px; margin: 0 auto; }
      .eyebrow { color: #b5532d; font-size: 12px; letter-spacing: 0.35em; text-transform: uppercase; }
      h1 { margin: 16px 0 12px; font-size: 32px; }
      .muted { color: rgba(17, 32, 49, 0.7); line-height: 1.7; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="eyebrow">FundScope</div>
      {% block content %}{% endblock %}
    </div>
  </body>
</html>
