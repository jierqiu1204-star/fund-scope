# Backend and Alembic load this file during local development.
# Frontend local variables belong in frontend/.env.local.
DATABASE_URL=postgresql+asyncpg://fundscope:fundscope@localhost:5432/fundscope
CORS_ORIGINS=http://localhost:3000
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-me
MODEL_NAME=gpt-4o-mini
# Optional LLM-assisted conservative research advisor.
# ECNU example:
# OPENAI_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
# MODEL_NAME=ecnu-plus
# OPENAI_API_KEY=<your-ecnu-token>
LLM_ADVISOR_ENABLED=false
LLM_ADVISOR_MAX_ASSETS=20
LLM_ADVISOR_TIMEOUT_SECONDS=30
LLM_ADVISOR_PROMPT_VERSION=short_research_advisor_v1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=FundScope <user@example.com>
NGINX_BASIC_AUTH_USER=fundscope
NGINX_BASIC_AUTH_PASS=replace-me
# Production PIT capture stays disabled until one complete dual-95% snapshot
# and factual cutoff/provider-health evidence have been verified.
ETF_PIT_CAPTURE_ENABLED=false
ETF_PIT_CODE_VERSION=
ETF_PIT_ARTIFACT_DIR=/app/data/etf-pit-artifacts
# Leader observations remain research-only and fail closed until a complete
# PIT source exists. The evidence API may be enabled independently so the UI
# reports exact readiness and accumulation reasons instead of hiding the panel.
ETF_LEADER_TACTICS_CONTINUATION_ENABLED=false
ETF_LEADER_TACTICS_EVIDENCE_API_ENABLED=false
ETF_LEADER_TACTICS_CODE_VERSION=
ETF_LEADER_TACTICS_ARTIFACT_DIR=/app/data/etf-leader-tactics-artifacts
