# Production research capture is fail-closed: PIT creation still requires a
# complete dual-95 snapshot and leader observations require a captured PIT
# source. These flags enable truthful status/continuation, not trade actions.
ETF_PIT_CAPTURE_ENABLED=true
ETF_PIT_CODE_VERSION=production_pit_capture_v1
ETF_PIT_ARTIFACT_DIR=/app/data/etf-pit-artifacts

ETF_LEADER_TACTICS_CONTINUATION_ENABLED=true
ETF_LEADER_TACTICS_EVIDENCE_API_ENABLED=true
ETF_LEADER_TACTICS_CODE_VERSION=leader_tactics_observation_v1
ETF_LEADER_TACTICS_ARTIFACT_DIR=/app/data/etf-leader-tactics-artifacts

# V2 scheduler and UI remain disabled by default.  The server's /srv/fundscope/.env
# is the authoritative runtime override; these tracked values are safe fallbacks.
ETF_LEADER_TACTICS_V2_API_ENABLED=false
ETF_LEADER_TACTICS_V2_CAPTURE_ENABLED=false
ETF_LEADER_TACTICS_V2_MATERIALIZE_ENABLED=false
