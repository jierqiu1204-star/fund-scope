# Production research capture is fail-closed: PIT creation still requires a
# complete dual-95 snapshot and leader observations require a captured PIT
# source. These flags enable truthful status/continuation, not trade actions.
ETF_PIT_CAPTURE_ENABLED=true
ETF_PIT_CODE_VERSION=production_pit_capture_v1
ETF_PIT_ARTIFACT_DIR=/app/data/etf-pit-artifacts

ETF_LEADER_TACTICS_CONTINUATION_ENABLED=true
ETF_LEADER_TACTICS_EVIDENCE_API_ENABLED=true
ETF_LEADER_TACTICS_CODE_VERSION=leader_tactics_observation_v1
ETF_LEADER_TACTICS_ARTIFACT_DIR=/app/data/etf-leader-tactics-artifacts

# V2 is staged A-share-first. Capture, A-share materialization, and read-only
# evidence are enabled; ETF V2 materialization remains off and none of these
# research paths can mutate the comprehensive ranking or trading state.
ETF_LEADER_TACTICS_V2_API_ENABLED=true
ETF_LEADER_TACTICS_V2_CAPTURE_ENABLED=true
ETF_LEADER_TACTICS_V2_MATERIALIZE_ENABLED=true
ETF_LEADER_TACTICS_V2_ETF_MATERIALIZE_ENABLED=true

# Late-day turnaround remains default-off until a real 14:28/38/48 provider
# session is validated. Its stores and schedulers are independent of ranking.
LATE_DAY_TURNAROUND_API_ENABLED=false
LATE_DAY_TURNAROUND_ETF_MATERIALIZE_ENABLED=false
LATE_DAY_TURNAROUND_ASHARE_CAPTURE_ENABLED=false
LATE_DAY_TURNAROUND_ASHARE_MATERIALIZE_ENABLED=false
